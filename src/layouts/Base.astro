---
import '@fontsource-variable/space-grotesk/index.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Starfield from '../components/Starfield.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ravi Arnan Irianto - Developer and Security Portfolio',
  description = 'Personal portfolio of Ravi Arnan Irianto: web development, cybersecurity, and selected projects including SOAR automation, full-stack apps, and security testing.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/RaviLogo.png', Astro.site);
---

<!doctype html>
<html lang="en" class="grain vignette">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/RaviLogo.png" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ravi Arnan Irianto" />
    <meta
      name="keywords"
      content="Ravi Arnan Irianto, portfolio, web developer, cybersecurity, security engineer, SOAR, react, astro, three.js"
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#030014" />
  </head>
  <body class="bg-void text-stardust antialiased">
    <Starfield />
    <slot />
    <script>
      import '../scripts/scroll';
    </script>
  </body>
</html>
