---
import '@fontsource-variable/space-grotesk/index.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Starfield from '../components/Starfield.astro';
import { site } from '../data/site';
import { education } from '../data/education';
import { skillCategories } from '../data/skills';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Ravi Arnan Irianto - Developer and Security Portfolio',
  description = 'Personal portfolio of Ravi Arnan Irianto: web development, cybersecurity, and selected projects including SOAR automation, full-stack apps, and security testing.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
/* Social share card: 1200x630, regenerated by `node scripts/og.mjs`.
   A PNG, not the WebP poster, because several scrapers still reject WebP. */
const ogImage = new URL('/og.png', Astro.site);

/* Structured data so search engines recognise the person entity */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  jobTitle: site.tagline,
  description: site.bio,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  sameAs: [site.socials.github, site.socials.linkedin, site.socials.instagram],
  image: new URL('/RaviLogo.png', Astro.site).href,
  worksFor: { '@type': 'Organization', name: site.experience.company },
  alumniOf: education.map((item) => ({
    '@type': 'EducationalOrganization',
    name: item.school,
  })),
  knowsAbout: skillCategories.flatMap((category) => category.skills),
};
---

<!doctype html>
<html lang="en" class="grain vignette">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/RaviLogo.png" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ravi Arnan Irianto" />
    <meta
      name="keywords"
      content="Ravi Arnan Irianto, portfolio, web developer, cybersecurity, security engineer, SOAR, react, astro, three.js"
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} - ${site.tagline}`} />
    <meta property="og:site_name" content="Ravi Arnan Irianto" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter: `name`, not `property`, is what the card spec asks for -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} - ${site.tagline}`} />

    <meta name="theme-color" content="#030014" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="bg-void text-stardust antialiased">
    <!-- data-skip-smooth: scroll.ts leaves this anchor to the browser so the
         native jump also moves focus into <main>, which Lenis would not do -->
    <a href="#main" class="skip-link" data-skip-smooth>Skip to content</a>
    <Starfield />
    <slot />
    <script>
      import '../scripts/scroll';
    </script>
  </body>
</html>
