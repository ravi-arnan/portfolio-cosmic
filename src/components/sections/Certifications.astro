---
import { Award, ExternalLink } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import { certifications } from '../../data/certifications';
---

<section id="certifications" data-stage="scene" class="scene-stage relative">
  <div class="scene-pin">
    <div class="scene-content relative mx-auto w-full max-w-6xl px-6" data-scene-content>
  <SectionHeading index="06" title="Certifications" />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {
      certifications.map((cert) => {
        /* Credentials without a public URL still get a card, just not a link. */
        const Card = cert.link ? 'a' : 'div';
        const linkProps = cert.link
          ? { href: cert.link, target: '_blank', rel: 'noopener noreferrer' }
          : {};
        return (
          <Card
            {...linkProps}
            class="group flex flex-col justify-between rounded-xl surface-card p-5 transition-colors hover:border-ion/40 active:border-ion/40"
          >
            <div>
              <Award size={18} class="mb-3 text-ion" />
              <h3 class="font-display text-sm leading-snug font-semibold text-starlight">
                {cert.title}
              </h3>
              <p class="mt-2 text-xs text-muted">{cert.issuer}</p>
            </div>
            <div class="mt-4 flex items-center justify-between">
              <span class="font-mono text-[10px] text-faint">{cert.date}</span>
              {cert.link && (
                <ExternalLink
                  size={12}
                  class="text-stardust/40 transition-colors group-hover:text-ion"
                />
              )}
            </div>
          </Card>
        );
      })
    }
  </div>
    </div>
  </div>
</section>
