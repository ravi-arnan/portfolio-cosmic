---
import { Menu, X } from '@lucide/astro';
import { site } from '../data/site';

/* Single source of truth for the in-page anchors, shared by the desktop
   bar and the mobile overlay so they never drift apart. */
const navLinks = [
  { href: '#about', label: 'about' },
  { href: '#work', label: 'work' },
  { href: '#skills', label: 'skills' },
  { href: '#contact', label: 'contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <!-- Scroll progress: a thin ember bar tracking position through the long
       single-page journey -->
  <div class="absolute inset-x-0 top-0 h-[2px] overflow-hidden" aria-hidden="true">
    <div
      id="scroll-progress"
      class="h-full origin-left bg-gradient-to-r from-ember to-ember-dim"
      style="transform: scaleX(0)"
    >
    </div>
  </div>
  <nav
    aria-label="Main navigation"
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
  >
    <a href="#hero" class="flex items-center gap-2">
      <img src="/RaviLogo.png" alt="" width="28" height="28" />
      <span class="font-mono text-sm text-starlight">ravi@arnan:~$</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 font-mono text-xs tracking-wider text-stardust md:flex">
      {
        navLinks.map(({ href, label }) => (
          <li>
            <a class="nav-link transition-colors hover:text-ember active:text-ember" href={href} data-nav-link>
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="rounded-full border border-ember/40 px-4 py-1.5 text-ember transition-colors hover:bg-ember hover:text-void"
          href={site.socials.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          github
        </a>
      </li>
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-starlight transition-colors hover:text-ember md:hidden"
    >
      <span data-menu-open><Menu size={22} /></span>
      <span data-menu-close class="hidden"><X size={22} /></span>
    </button>
  </nav>

  <!-- Mobile overlay menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden flex-col bg-void/95 backdrop-blur-md md:hidden"
  >
    <nav
      aria-label="Mobile navigation"
      class="flex h-full flex-col items-center justify-center gap-8 font-mono text-lg tracking-wider text-stardust"
    >
      {
        navLinks.map(({ href, label }) => (
          <a class="nav-link transition-colors hover:text-ember active:text-ember" href={href} data-nav-link>
            {label}
          </a>
        ))
      }
      <a
        class="mt-2 rounded-full border border-ember/40 px-6 py-2 text-ember transition-colors hover:bg-ember hover:text-void"
        href={site.socials.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        github
      </a>
    </nav>
  </div>

  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-void/90 to-transparent"
  >
  </div>
</header>

<style>
  /* Active-section highlight, toggled by the script below */
  .nav-link.is-active {
    color: var(--color-ember);
    text-shadow: 0 0 12px rgb(255 157 60 / 0.5);
  }
</style>

<script>
  /* ---- Mobile menu toggle ---- */
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggle?.querySelector('[data-menu-open]');
  const closeIcon = toggle?.querySelector('[data-menu-close]');

  /* The open overlay covers the page, so everything behind it goes inert:
     without this, Tab walks off the menu into links nobody can see. */
  const behindMenu = document.querySelectorAll('main, footer');

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    behindMenu.forEach((el) => el.toggleAttribute('inert', open));
  }

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Close on link tap, Escape, or when crossing back to the desktop breakpoint
  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => setMenu(false))
  );
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });
  matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });

  /* ---- Active-section highlight ---- */
  /* Sections without their own nav link fold into the preceding region so
     the bar always reflects roughly where the visitor is. */
  const sectionToHref: Record<string, string> = {
    about: '#about',
    work: '#work',
    contributions: '#work',
    skills: '#skills',
    education: '#skills',
    certifications: '#skills',
    contact: '#contact',
  };

  const navLinkEls = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
  );

  function setActive(href: string) {
    navLinkEls.forEach((link) => {
      const on = link.getAttribute('href') === href;
      link.classList.toggle('is-active', on);
      if (on) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  const watched = Object.keys(sectionToHref)
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (watched.length > 0) {
    let activeId: string | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) activeId = entry.target.id;
        }
        if (activeId && sectionToHref[activeId]) setActive(sectionToHref[activeId]);
      },
      // a thin band across the viewport middle: the section crossing the
      // centre line is the "current" one
      { rootMargin: '-45% 0px -45% 0px' }
    );
    watched.forEach((section) => observer.observe(section));
  }

  /* ---- Scroll progress bar ---- */
  /* Reads window.scrollY directly so it works in every mode (Lenis smooth,
     reduced-motion native scroll) without depending on the choreography. */
  const progressBar = document.getElementById('scroll-progress');
  if (progressBar) {
    let ticking = false;
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      progressBar.style.transform = `scaleX(${progress})`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateProgress);
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', updateProgress);
    updateProgress();
  }
</script>
