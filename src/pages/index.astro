---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Work from '../components/sections/Work.astro';
import Contributions from '../components/sections/Contributions.astro';
import Skills from '../components/sections/Skills.astro';
import Education from '../components/sections/Education.astro';
import Certifications from '../components/sections/Certifications.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base>
  <Loader />
  <Nav />
  <!-- Persistent 3D layer: one scene choreographed across the whole page.
       Stays empty unless the gate below passes; the hero poster shows through. -->
  <div id="scene-root" class="pointer-events-none fixed inset-0 z-0"></div>
  <main id="main" tabindex="-1" class="relative z-10">
    <Hero />
    <About />
    <Work />
    <Contributions />
    <Skills />
    <Education />
    <Certifications />
    <Contact />
  </main>
  <Footer />

  <script>
    /* Capability gate for the blackhole scene. It runs before anything from
       the 3D stack is fetched, so reduced-motion, small-screen, low-memory
       and no-WebGL2 visitors download neither React nor three.js and keep
       the static poster instead. */
    const memory = (navigator as Navigator & { deviceMemory?: number }).deviceMemory;

    const canRunScene =
      !matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !matchMedia('(max-width: 767px)').matches &&
      !(memory !== undefined && memory < 4) &&
      !!document.createElement('canvas').getContext('webgl2');

    if (canRunScene) import('../components/three/mount');
  </script>
</Base>
