---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import BlackholeHero from '../components/three/BlackholeHero';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Work from '../components/sections/Work.astro';
import Contributions from '../components/sections/Contributions.astro';
import Skills from '../components/sections/Skills.astro';
import Education from '../components/sections/Education.astro';
import Certifications from '../components/sections/Certifications.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base>
  <Loader />
  <Nav />
  <!-- Persistent 3D layer: one scene choreographed across the whole page -->
  <div class="pointer-events-none fixed inset-0 z-0">
    <BlackholeHero client:only="react" />
  </div>
  <main class="relative z-10">
    <Hero />
    <About />
    <Work />
    <Contributions />
    <Skills />
    <Education />
    <Certifications />
    <Contact />
  </main>
  <Footer />
</Base>
