---
import { ArrowLeft } from '@lucide/astro';
import Base from '../layouts/Base.astro';
---

<Base title="404 - Lost beyond the event horizon" noindex>
  <main
    id="main"
    tabindex="-1"
    class="flex min-h-screen flex-col items-center justify-center px-6 text-center"
  >
    <p class="font-mono text-sm text-ember">404 // singularity</p>
    <h1 class="mt-4 font-display text-4xl font-bold text-starlight md:text-6xl">
      This page fell past the event horizon
    </h1>
    <p class="mt-4 max-w-md text-stardust">
      Nothing escapes from here, but you still can.
    </p>
    <a
      href="/"
      class="mt-10 inline-flex items-center gap-2 rounded-full border border-ember/40 px-6 py-3 font-mono text-sm text-ember transition-colors hover:bg-ember hover:text-void"
    >
      <ArrowLeft size={15} />
      escape to home
    </a>
  </main>
</Base>
